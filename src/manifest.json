{
  "manifest_version": 3,
  "name": "Claude Utilities",
  "version": "1.5.1",
  "description": "チャット幅調整・サイドバー幅調整・使用量表示",
  "permissions": ["storage", "alarms", "activeTab"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://anthropic.statuspage.io/*"
  ],
  "action": {
    "default_title": "Claude Utilities",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*", "https://claude.com/*"],
      "js": [
        "shared/pageContext.js",
        "shared/constants.js",
        "shared/i18n.js",
        "content/wide.js",
        "content/usage.js",
        "content/sidebar.js",
        "content/status.js",
        "content/main.js"
      ],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
