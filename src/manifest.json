{
  "manifest_version": 3,
  "name": "Claude Utilities",
  "version": "1.1.2",
  "description": "チャット幅調整・使用量表示",
  "permissions": ["storage", "alarms", "activeTab"],
  "host_permissions": ["https://claude.ai/*"],
  "action": {
    "default_title": "Claude Utilities",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*", "https://claude.com/*"],
      "js": ["pageContext.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
